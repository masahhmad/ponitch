#!/usr/bin/env python3
"""notchctl: control the ponitch notch over its unix socket."""
import json
import os
import socket
import sys

COMMANDS = ("toggle", "open", "close", "tuck", "untuck", "pin", "unpin", "state")


def main():
    # open takes an optional tab: notchctl open music
    args = sys.argv[1:]
    if not args or args[0] not in COMMANDS or len(args) > (2 if args[0] == "open" else 1):
        print(f"usage: notchctl {{{'|'.join(COMMANDS)}}}  (open [tab])", file=sys.stderr)
        return 2
    req = {"cmd": args[0], **({"tab": args[1]} if len(args) == 2 else {})}
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "ponitch.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(2)
            s.connect(path)
            s.sendall((json.dumps(req) + "\n").encode())
            reply = json.loads(s.makefile().readline())
    except (OSError, ValueError) as e:
        print(f"notchctl: ponitch is not running ({e})", file=sys.stderr)
        return 1
    if not reply.get("ok"):
        print(f"notchctl: {reply.get('error')}", file=sys.stderr)
        return 1
    print(reply["state"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
